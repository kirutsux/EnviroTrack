<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="#445B6C" />

        <!-- Main Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Permit to Operate (PTO) — Application"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/textPrimary"
                    android:gravity="center"
                    android:layout_marginBottom="4dp" />

                <!-- Subheader -->
                <TextView
                    android:id="@+id/subHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Please fill out all required fields accurately before submitting your application."
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginBottom="16dp" />

                <!-- Section A: General Information -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A. General Information"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/textPrimary"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Name of Owner"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputOwnerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Name of Establishment"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputEstablishmentName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Mailing Address"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputMailingAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Plant Address"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPlantAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section B: Company Information -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B. Company Information"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/textPrimary"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="TIN"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputTin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Nature of Ownership (e.g. Corporation)"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputOwnershipType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Nature of Business"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputNatureOfBusiness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="PCO Name"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPcoName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="PCO Accreditation No."
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPcoAccreditation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section C: Operational Information -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C. Operational Information"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/textPrimary"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Operating Hours (e.g. 8 hrs/day)"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputOperatingHours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Total Employees"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputTotalEmployees"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Land Area (m²)"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputLandArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section D: Equipment / Emissions -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="D. Equipment / Emissions"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/textPrimary"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Equipment Name (e.g. Generator Set)"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputEquipmentName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Type of Fuel (e.g. Diesel)"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputFuelType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Brief summary (e.g. NOx, SOx, PM...)"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputEmissions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:maxLines="4"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section E: Supporting Documents -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E. Supporting Documents"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/textPrimary"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/fileHintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload required documents (PDF/Image format)."
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnUploadFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload File(s)"
                    android:layout_marginBottom="12dp"
                    app:backgroundTint="@color/primary"
                    android:textColor="@color/bg_white" />

                <TextView
                    android:id="@+id/txtFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No files selected"
                    android:textStyle="italic"
                    android:textColor="@color/textSecondary"
                    android:layout_marginBottom="24dp" />

                <!-- Submit Button -->
                <Button
                    android:id="@+id/btnSubmitPto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save and Continue to Review"
                    android:enabled="false"
                    app:backgroundTint="@color/primary"
                    android:textColor="@color/bg_white" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
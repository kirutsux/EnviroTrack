<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#F8FAFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header Row: Application Name + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- 🏢 Application Name (expands to push badge to the right) -->
            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ECOLAND PETRON SERVICE CENTER"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1E2A35"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- STATUS BADGE (fixed on the right) -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textStyle="bold"
                android:textSize="12sp"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_status_badge"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- 👤 Applicant -->
        <TextView
            android:id="@+id/tvApplicant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="John C. Dela Cruz II"
            android:textSize="13sp"
            android:textColor="#5A6D85"
            android:layout_marginBottom="10dp" />

        <!-- 📋 Details Section with Dividers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:showDividers="middle|beginning|end"
            android:divider="@drawable/divider_gray"
            android:dividerPadding="8dp">

            <TextView
                android:id="@+id/tvForwardedTo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forwarded to: Melvin M. Dapitanon"
                android:textColor="#3E4C59"
                android:textSize="13sp"
                android:paddingVertical="6dp" />

            <TextView
                android:id="@+id/tvUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last updated: Sept 28, 2021"
                android:textColor="#3E4C59"
                android:textSize="13sp"
                android:paddingVertical="6dp" />

            <TextView
                android:id="@+id/tvType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Type: Renewal"
                android:textColor="#2980B9"
                android:textSize="13sp"
                android:paddingVertical="6dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
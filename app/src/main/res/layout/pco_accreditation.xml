<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/backbtn"
            android:contentDescription="Back"
            app:tint="#445B6C" />

        <!-- Main Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header -->
                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PCO Accreditation"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/textPrimary"
                    android:gravity="center"
                    android:layout_marginBottom="4dp" />

                <!-- Subheader -->
                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Register and apply for official PCO accreditation with the EMB."
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginBottom="16dp" />

                <!-- Section: Personal and Professional Details -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A. Personal and Professional Details"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/textPrimary"
                    android:layout_marginBottom="12dp" />

                <!-- Full Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Full Name"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Position / Designation -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Position / Designation"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/positionDesignation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Accreditation Number -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Accreditation Number (if existing)"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/accreditationNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Company Affiliation -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Company Affiliation"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/companyAffiliation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Educational Background -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Educational Background"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/educationalBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Experience -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Experience in Environmental Management"
                    app:boxStrokeColor="@color/input_field_border"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@color/input_field_background">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/experienceInEnvManagement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section: Upload Documents -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B. Supporting Documents"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/textPrimary"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uploadCertificateButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload PCO Certificate / License"
                    app:backgroundTint="@color/primary"
                    android:textColor="@color/bg_white"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uploadGovernmentIDButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload Government-issued ID"
                    app:backgroundTint="@color/primary"
                    android:textColor="@color/bg_white"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uploadTrainingCertificateButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload Training Certificates"
                    app:backgroundTint="@color/primary"
                    android:textColor="@color/bg_white"
                    android:layout_marginBottom="24dp" />

                <!-- Submit -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submitApplicationButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Submit Application"
                    app:backgroundTint="@color/primary"
                    android:textColor="@color/bg_white" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

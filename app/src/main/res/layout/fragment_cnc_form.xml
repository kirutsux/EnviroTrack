<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollCNC"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="#445B6C" />

        <!-- Main Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Module Header -->
                <TextView
                    android:id="@+id/tvTitleCNC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Certificate of Non-Coverage (CNC) Application"
                    android:textSize="20sp"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitleCNC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Please fill out all required fields accurately before submitting your CNC application."
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="4dp" />

                <!-- Section A: Basic Information -->
                <TextView
                    android:id="@+id/tvSectionA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A. Basic Information"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputCompanyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Company Name"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputBusinessName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Business/Establishment Name"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputProjectTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Project Title"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputNatureOfBusiness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nature of Business"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputProjectLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Project Location (Address, Barangay, Municipality/City, Province)"
                        android:inputType="textMultiLine" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Email Address"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputManagingHead"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Managing Head Name"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPcoName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Pollution Control Officer Name"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPcoAccreditation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="PCO Accreditation No."
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputDateEstablished"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Date of Establishment"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputEmployees"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Number of Employees"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPsicCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="PSIC Code / Industry Classification"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section B: Project Description -->
                <TextView
                    android:id="@+id/tvSectionB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B. Project Description"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:layout_marginTop="20dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputProjectType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Project Type (e.g., Manufacturing, Retail, Service)"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputProjectScale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Project Size/Scale (Small, Medium, Large)"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputProjectCost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Project Cost / Capital Investment (₱)"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputLandArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Land Area (sq. meters or hectares)"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputRawMaterials"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Raw Materials Used"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputProductionCapacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Production Capacity"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputUtilitiesUsed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Utilities Used (Water, Power, Fuel, etc.)"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputWasteGenerated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Waste Generated (solid, liquid, hazardous)"
                        android:inputType="textMultiLine" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section C: Location and Environmental Setting -->
                <TextView
                    android:id="@+id/tvSectionC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C. Location and Environmental Setting"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:layout_marginTop="20dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputCoordinates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Coordinates (Latitude, Longitude)"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputNearbyWaters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nearby Bodies of Water"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputResidentialProximity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Proximity to Residential Areas"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputEnvFeatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Environmental Features Nearby (forest, agricultural land, protected areas)"
                        android:inputType="textMultiLine" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputZoning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Zoning Classification"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section D: Attachments / Uploads -->
                <TextView
                    android:id="@+id/tvSectionD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="D. Attachments / Uploads"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:id="@+id/tvUploadDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload the following documents (PDF/IMAGE formats):\n• Location Map\n• Vicinity Map\n• Project Layout / Site Development Plan\n• Business Permit / DTI/SEC Registration\n• Land Title / Lease Agreement\n• Authorization Letter (if applicable)\n• Proof of Non-Coverage Justification (Project Description Document)"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUploadFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload Files"
                    android:layout_marginTop="12dp"
                    app:backgroundTint="@color/primary"
                    android:textColor="@color/bg_white" />

                <TextView
                    android:id="@+id/txtFileNames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No files selected"
                    android:textStyle="italic"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="8dp" />

                <!-- Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveCNC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save CNC Application"
                    android:layout_marginTop="16dp"
                    app:backgroundTint="@color/primary"
                    android:textColor="@color/bg_white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitCnc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save and Continue to Payment"
                    android:layout_marginTop="12dp"
                    app:backgroundTint="@color/primary"
                    android:textColor="@color/bg_white" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header -->
    <TextView
        android:id="@+id/tvTitle"
        android:text="Certificate of Non-Coverage For Review"
        android:textStyle="bold"
        android:textSize="21sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_enviro_header_teal"
        android:padding="16dp"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:elevation="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Section Title -->
    <TextView
        android:text="Submitted Applications"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#34656D"
        android:background="@drawable/bg_enviro_section_light"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:elevation="1dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 🔍 Search and Filter Row -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <!-- Search Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_enviro_card"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical"
            android:elevation="1dp">

            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Search"
                app:tint="#34656D" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search applications..."
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:padding="6dp"
                android:textColor="#263238"
                android:textColorHint="#9E9E9E"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Filter Spinner -->
        <Spinner
            android:id="@+id/spinnerStatus"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:padding="8dp"
            android:background="@drawable/bg_enviro_card"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/txtNoApplications"
        android:text="You have no submitted applications yet."
        android:textColor="#607D8B"
        android:textSize="14sp"
        android:background="@drawable/bg_enviro_card"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="12dp"
        android:elevation="1dp" />

    <!-- List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEmbCncList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="vertical" />
</LinearLayout>

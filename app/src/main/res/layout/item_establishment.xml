<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="5dp"
    app:cardUseCompatPadding="true"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header Row: Establishment Name + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- 🏢 Establishment Name (takes available space) -->
            <TextView
                android:id="@+id/tvEstablishment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ABC Manufacturing Corp."
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- STATUS BADGE (fixed on the right) -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textStyle="bold"
                android:textSize="12sp"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:background="@drawable/bg_status_badge"
                android:textColor="@android:color/white"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- 🏭 Company Type -->
        <TextView
            android:id="@+id/tvCompanyType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Type: Corporation"
            android:textSize="13sp"
            android:textColor="@color/darker_gray"
            android:layout_marginBottom="4dp" />

        <!-- 👤 CEO Name -->
        <TextView
            android:id="@+id/tvCeoName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CEO: John Doe"
            android:textSize="13sp"
            android:textColor="@color/darker_gray"
            android:layout_marginBottom="4dp" />

        <!-- 📍 Address -->
        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="123 Purok 4, Brgy. San Juan, Quezon City"
            android:textSize="13sp"
            android:textColor="@color/darker_gray"
            android:layout_marginBottom="8dp" />

        <!-- 📅 Date Submitted & Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Date Submitted (left) -->
            <TextView
                android:id="@+id/tvDateSubmitted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2025-10-10"
                android:textColor="@color/darker_gray"
                android:textSize="12sp" />

            <!-- Action Buttons (right) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnEdit"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_edit"
                    android:contentDescription="Edit Establishment"
                    app:tint="@color/orange_submitted" />

                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_delete"
                    android:contentDescription="Delete Establishment"
                    app:tint="@color/red_rejected" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>